# Copy to .env (git-ignored) and fill in. Loaded by scrape.py and serve.py.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: model used for genre tagging and venue extraction (default claude-opus-5)
# LIVEMUSIC_MODEL=claude-opus-5
# Optional: Spotify app credentials (https://developer.spotify.com/dashboard) so the detail sheet can
# embed the artist's Spotify player when they are not on Bandcamp. Without them Spotify is skipped.
# SPOTIFY_CLIENT_ID=...
# SPOTIFY_CLIENT_SECRET=...
